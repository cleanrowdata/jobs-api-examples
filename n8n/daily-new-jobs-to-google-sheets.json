{
  "name": "Daily new jobs from 17,500 company career sites to Google Sheets (Apify Job Postings API)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Every day at 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/cleanrowdata~fresh-jobs-index/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"timeRange\": \"7d\",\n  \"titleSearch\": [\n    \"marketing manager\"\n  ],\n  \"locationSearch\": [\n    \"United States\",\n    \"Remote\"\n  ],\n  \"onlyNewSinceLastRun\": true,\n  \"stateKey\": \"n8n-daily-sheet\",\n  \"includeDescription\": false,\n  \"limit\": 200\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Get new jobs from Apify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "notes": "Credential: Header Auth, name = Authorization, value = Bearer <your Apify API token>"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f0",
              "name": "posted_at",
              "value": "={{ $json.posted_at }}",
              "type": "string"
            },
            {
              "id": "f1",
              "name": "company",
              "value": "={{ $json.company }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "title",
              "value": "={{ $json.title }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "location",
              "value": "={{ $json.location }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "salary_text",
              "value": "={{ $json.salary_text }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "ats",
              "value": "={{ $json.ats }}",
              "type": "string"
            },
            {
              "id": "f6",
              "name": "job_url",
              "value": "={{ $json.job_url }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Pick columns",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Append to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        0
      ],
      "notes": "Create a sheet with headers: posted_at, company, title, location, salary_text, ats, job_url. Paste its URL here."
    }
  ],
  "connections": {
    "Every day at 8:00": {
      "main": [
        [
          {
            "node": "Get new jobs from Apify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get new jobs from Apify": {
      "main": [
        [
          {
            "node": "Pick columns",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pick columns": {
      "main": [
        [
          {
            "node": "Append to Google Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}