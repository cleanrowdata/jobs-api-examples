        "method": "POST",
        "url": "https://api.apify.com/v2/acts/cleanrowdata~fresh-jobs-index/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  timeRange: '7d',\n  titleSearch: $json.job_titles.split(',').map(s => s.trim()).filter(Boolean),\n  locationSearch: $json.locations.split(',').map(s => s.trim()).filter(Boolean),\n  onlyNewSinceLastRun: true,\n  stateKey: $json.saved_search_name,\n  includeDescription: false,\n  limit: $json.max_jobs_per_run\n}) }}",
        "options": {
          "timeout": 300000
        }
      },
