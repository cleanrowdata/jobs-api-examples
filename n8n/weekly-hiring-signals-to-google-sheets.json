{
  "name": "Weekly companies hiring for a function to Google Sheets (Apify Hiring Signals API)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Every Monday at 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/cleanrowdata~hiring-signals-api/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"timeRange\": \"7d\",\n  \"jobFunctions\": [\n    \"sales\"\n  ],\n  \"locationSearch\": [\n    \"United States\"\n  ],\n  \"minNewJobs\": 3,\n  \"onlyNewSinceLastRun\": true,\n  \"stateKey\": \"n8n-hiring-signals\",\n  \"limit\": 100\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Get new jobs from Apify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "notes": "Credential: Header Auth, name = Authorization, value = Bearer <your Apify API token>"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f0",
              "name": "company",
              "value": "={{ $json.company }}",
              "type": "string"
            },
            {
              "id": "f1",
              "name": "company_domain",
              "value": "={{ $json.company_domain }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "ats",
              "value": "={{ $json.ats }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "new_jobs",
              "value": "={{ $json.new_jobs }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "open_jobs_matching",
              "value": "={{ $json.open_jobs_matching }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Pick columns",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Append to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        0
      ],
      "notes": "Create a sheet with headers: company, company_domain, ats, new_jobs, open_jobs_matching. Paste its URL here."
    }
  ],
  "connections": {
    "Every Monday at 8:00": {
      "main": [
        [
          {
            "node": "Get new jobs from Apify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get new jobs from Apify": {
      "main": [
        [
          {
            "node": "Pick columns",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pick columns": {
      "main": [
        [
          {
            "node": "Append to Google Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}